<ui:FluentWindow x:Class="OpenAIClient.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:OpenAIClient"
                 mc:Ignorable="d"
                 ResizeMode="CanResize"
                 Title="OpenAI Client"
                 Height="600"
                 Width="1000"
                 MinHeight="450"
                 MinWidth="650"
                 WindowStartupLocation="CenterScreen"
                 WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar  Grid.Row="0" Title="OpenAI Client" 
                      ShowMinimize="True"
                      ShowMaximize="True"
                      ShowClose="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="URL serveru" />
                    <ui:TextBox x:Name="ServerUrlTextBox" Text="{x:Static local:MainWindow.DefaultServerUrl}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="LLM model" />
                    <ui:TextBox x:Name="ModelNameTextBox" Text="{x:Static local:MainWindow.DefaultModelName}" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Token" />
                    <ui:TextBox x:Name="AuthenticationTokenTextBox" Text="{x:Static local:MainWindow.DefaultAuthenticationToken}" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Padding="0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8">
                <RichTextBox x:Name="ConversationRichTextBox"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Padding="4"
                         Background="Transparent"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled">
                    <RichTextBox.Document>
                        <FlowDocument PagePadding="0" />
                    </RichTextBox.Document>
                </RichTextBox>
            </Border>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ProcessingStatusTextBlock"
                       Grid.Row="0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text=""
                       Visibility="Collapsed" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="MessageTextBox"
                            Grid.Column="0"
                            MinHeight="42"
                            VerticalContentAlignment="Center"
                            PlaceholderText="Napište zprávu..."
                            KeyDown="MessageTextBox_KeyDown" />
                    <ui:Button x:Name="SendButton"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           MinWidth="110"
                           Content="Odeslat"
                           Appearance="Primary"
                           Click="SendButton_Click" />
                    <ui:Button x:Name="CloseButton"
                           Grid.Column="2"
                           Margin="8,0,0,0"
                           MinWidth="110"
                           Content="Zavřít"
                           Click="CloseButton_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
